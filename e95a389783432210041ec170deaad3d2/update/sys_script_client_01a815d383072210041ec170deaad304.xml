        <name>Validate Date</name>
        <order/>
        <script><![CDATA[function onSubmit() {
   
    var startTime = g_form.getValue('u_start_time');
    var endTime = g_form.getValue('u_end_time');

  
    var start = new GlideDateTime(startTime);
    var end = new GlideDateTime(endTime);

    if (end.before(start)) {
        g_form.showFieldMsg('u_end_time', 'End Time cannot be before Start Time.', 'error');
        return false; }

    return true; 
}]]></script>
