        <name>Validate Contact Number</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onSubmit() {
   
    var contactNumber = g_form.getValue('v_contact_number'); 

    
    var digitsOnly = contactNumber.replace(/\D/g, '');

    if (!/^\d{10}$/.test(digitsOnly)) {
        g_form.addErrorMessage("Please enter a valid 10-digit contact number.");
        return false; 
    }

    return true; 
   
}]]></script>
