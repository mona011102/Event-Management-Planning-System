        <script><![CDATA[function onClick() {
    var firstName = g_form.getValue('u_first_name');
    var lastName = g_form.getValue('u_last_name');
    var email = g_form.getValue('u_email');
    var contactNumber = g_form.getValue('u_contact_number');
    var eventId = g_form.getUniqueValue();

    var ga = new GlideAjax('RegisterAttendeeHelper');
    ga.addParam('sysparm_name', 'registerAttendee');
    ga.addParam('sysparm_first_name', firstName);
    ga.addParam('sysparm_last_name', lastName);
    ga.addParam('sysparm_email', email);
    ga.addParam('sysparm_contact_number', contactNumber);
    ga.addParam('sysparm_event_id', eventId);

    ga.getXMLAnswer(function(response) {
        alert(response);
        g_form.clearMessages();
        g_form.addInfoMessage(response);
    });
}
