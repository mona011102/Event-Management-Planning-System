        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    // Add your code here
    var eventID = current.u_event_id;

    // Find matching Budget record
    var budgetGR = new GlideRecord('x_1790229_event_ma_budget');
    budgetGR.addQuery('u_event_id', eventID);
    budgetGR.query();

    if (budgetGR.next()) {
        // Safely parse values
        var spent = parseFloat(budgetGR.u_amount_spent || 0);
        var total = parseFloat(budgetGR.u_total_budget || 0);
        var newExpense = parseFloat(current.u_amount || 0);

        // Update spent and remaining
        spent += newExpense;
        budgetGR.u_amount_spent = spent;
        budgetGR.u_amount_remaining = total - spent;

        budgetGR.update();
    }

})(current, previous);]]></script>
